# Local development: start PostgreSQL with `docker compose up -d`.
DATABASE_URL="postgresql://motika:motika_local_dev@localhost:5433/motika_services?schema=public"

# Public base URL of the deployed site (no trailing slash).
APP_URL="http://localhost:3000"

# Gmail SMTP contact form. Use a Google App Password, not your Gmail password.
CONTACT_EMAIL="crithltd@gmail.com"
GMAIL_USER="crithltd@gmail.com"
GMAIL_APP_PASSWORD=""

# Flutterwave server-side credentials. Never use NEXT_PUBLIC_ for secret keys.
FLW_SECRET_KEY=""
# Set this exact value as the webhook secret hash in Flutterwave Dashboard > Settings > Webhooks.
FLW_SECRET_HASH=""

# Admin login. Generate a bcrypt hash as shown in README.md.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""
# Use a random value of at least 32 characters.
ADMIN_SESSION_SECRET=""
